# Copy to .env next to docker-compose.yml. Every value has a sensible default.

# Where Ollama is. Docker: host.docker.internal. Local run: http://localhost:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b

# Signs login tokens. Change it before sharing the app.
SECRET_KEY=change-me-before-sharing
DEMO_PASSWORD=sentinel

# Local run only (Docker sets this itself):
# DATABASE_URL=mysql+pymysql://sentinel:sentinel@localhost:3307/sentinel

# Optional tuning:
# LLM_TIMEOUT_S=180
# ABSTAIN_BELOW=0.35
# EVAL_REVIEW_DELAY_S=120
